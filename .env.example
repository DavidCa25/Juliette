# Copia este archivo como .env y completa los valores. Ninguno es obligatorio para que el sitio funcione.

# Dominio final del sitio
VITE_SITE_URL=https://tudominio.com

# WhatsApp en formato internacional, sin "+" ni espacios (ej. 5215512345678)
VITE_WHATSAPP=

# Correo de contacto
VITE_CONTACT_EMAIL=

# (Opcional) URL que recibe cada pedido en JSON: Formspree, Make, Zapier, Google Apps Script…
VITE_ORDER_WEBHOOK=

# (Opcional) URL para suscripciones al boletín (Formspree, Mailchimp, Brevo…)
VITE_NEWSLETTER_ENDPOINT=

# (Opcional) Enlace de pago con tarjeta (Mercado Pago, Stripe Payment Link, etc.)
VITE_PAYMENT_LINK=

# (Opcional) Analítica y marketing; solo se cargan si la persona acepta cookies
VITE_GA_ID=
VITE_META_PIXEL_ID=
