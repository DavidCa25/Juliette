# Copia este archivo como .env y completa los valores. Ninguno es obligatorio para que el sitio funcione.

# Dominio final del sitio
VITE_SITE_URL=https://tudominio.com

# WhatsApp en formato internacional, sin "+" ni espacios (ej. 5215512345678)
VITE_WHATSAPP=

# Correo de contacto
VITE_CONTACT_EMAIL=

# (Opcional) URL que recibe cada pedido en JSON: Formspree, Make, Zapier, Google Apps Script…
VITE_ORDER_WEBHOOK=

# (Opcional) URL para suscripciones al boletín (Formspree, Mailchimp, Brevo…)
VITE_NEWSLETTER_ENDPOINT=

# (Opcional) Enlace de pago con tarjeta (Mercado Pago, Stripe Payment Link, etc.)
VITE_PAYMENT_LINK=

# ===== Panel /admin (solo en Vercel o en .env.local; nunca en el código) =====
# Better Auth: secreto aleatorio de 32+ caracteres y URL pública del sitio
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://tudominio.com
# Inicio de sesión con Google (Google Cloud Console › Credenciales)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Correos que pueden entrar al panel, separados por coma
ADMIN_EMAILS=julietteaa2709@gmail.com
# Token de GitHub con permiso Contents: Read and write sobre el repo
GITHUB_TOKEN=
GITHUB_REPO=DavidCa25/Juliette
GITHUB_BRANCH=main
# ===== Sentry (errores del sitio y del servidor) =====
# DSN del proyecto (Sentry › Settings › Client Keys). El mismo valor en ambas.
VITE_SENTRY_DSN=
SENTRY_DSN=
# (Opcional) Para ver los errores con el código legible: token de autenticación, organización y proyecto
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# ===== Resend (correos de pedidos) =====
RESEND_API_KEY=
# Remitente de un dominio verificado en Resend, p. ej. Julietté <pedidos@tudominio.com>
EMAIL_FROM=
# A quién avisar de pedidos nuevos (si se deja vacío, se usa ADMIN_EMAILS)
ORDER_NOTIFY_EMAIL=
# Newsletter: clave de Resend con acceso completo (Full access) para contactos y boletines.
# Si no se define, se usa RESEND_API_KEY (que entonces debe ser Full access).
RESEND_MARKETING_KEY=
# Id del segmento de Resend al que se suman los suscriptores y se envían los boletines
RESEND_SEGMENT_ID=

# Base de datos Neon (se agrega sola al conectar Neon desde Vercel › Storage/Marketplace)
DATABASE_URL=
# Cloudflare R2 (fotos y videos subidos desde el panel)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=juliette-media
# URL pública del bucket (dominio propio, p. ej. https://media.tudominio.com, o el r2.dev del bucket)
R2_PUBLIC_URL=

# (Opcional) Analítica y marketing; solo se cargan si la persona acepta cookies
VITE_GA_ID=
VITE_META_PIXEL_ID=
