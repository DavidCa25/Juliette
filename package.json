    "@neon/env": "^2.1.6",
    "@neondatabase/serverless": "^1.2.1",
    "@sentry/node": "^11.14.0",
    "@sentry/react": "^11.14.0",
    "aws4fetch": "^1.0.20",
    "better-auth": "^1.7.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "resend": "^6.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "^11.14.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vercel/node": "^31.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.0",
