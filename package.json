{
  "name": "juliette-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Sitio web de Julietté — Romance hecho arte.",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/migrate.mjs && tsc --noEmit && tsc -p tsconfig.api.json && vite build && node scripts/postbuild.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json",
    "dev:full": "vercel dev"
  },
  "dependencies": {
